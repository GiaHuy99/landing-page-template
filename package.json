{
  "name": "landing-page-template",
  "description": "Reusable Next.js landing page starter template",
  "private": true,
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@opennextjs/cloudflare": "1.14.0",
    "lucide-react": "^0.511.0",
    "next": "16.0.7",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "swiper": "^11.2.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3",
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.2",
    "eslint-config-next": "16.0.7",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "wrangler": "4.88.0"
  },
  "scripts": {
    "build": "next build",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv env.d.ts",
    "check": "npm run build && tsc --noEmit",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "dev": "next dev",
    "lint": "next lint",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "start": "next start"
  }
}
